# Browser requests use the same-origin Vite/Nginx proxy by default.
VITE_API_BASE_URL=/api

# Development-only upstream used by Vite. It is never exposed to production JS.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Default request timeout. Synchronous ingestion overrides this with a longer timeout.
VITE_API_TIMEOUT_MS=30000
