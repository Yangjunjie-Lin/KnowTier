# Local infrastructure. Replace these development-only values outside local use.
POSTGRES_DB=cognigraph
POSTGRES_USER=cognigraph
POSTGRES_PASSWORD=cognigraph-local-password
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=cognigraph-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

API_PORT=8000
COGNIGRAPH_ENVIRONMENT=development
COGNIGRAPH_DATABASE_URL=postgresql+asyncpg://cognigraph:cognigraph-local-password@localhost:5432/cognigraph
COGNIGRAPH_NEO4J_URI=bolt://localhost:7687
COGNIGRAPH_NEO4J_USER=neo4j
COGNIGRAPH_NEO4J_PASSWORD=cognigraph-local-password
COGNIGRAPH_NEO4J_REQUIRED=false
COGNIGRAPH_STORAGE_PATH=data/uploads
COGNIGRAPH_MAX_UPLOAD_BYTES=26214400

# Mock mode is deterministic and needs no provider credentials.
COGNIGRAPH_USE_MOCK_LLM=true
COGNIGRAPH_TEACHER_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_EXTRACTOR_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_GRADER_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_GRAPH_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_VISION_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_EMBEDDING_MODEL=openai/text-embedding-3-small
COGNIGRAPH_FALLBACK_MODELS=[]
COGNIGRAPH_API_KEY=
COGNIGRAPH_LLM_TIMEOUT_SECONDS=30
COGNIGRAPH_LLM_MAX_RETRIES=2
COGNIGRAPH_LLM_MAX_CONCURRENCY=4

COGNIGRAPH_CONTEXT_TOKEN_BUDGET=4000
COGNIGRAPH_RECENT_TURN_LIMIT=6
COGNIGRAPH_GRAPH_MAX_DEPTH=3
COGNIGRAPH_GRAPH_MAX_NODES=100
COGNIGRAPH_OUTBOX_WORKER_ENABLED=true
COGNIGRAPH_OUTBOX_POLL_INTERVAL_SECONDS=1
COGNIGRAPH_OUTBOX_BATCH_SIZE=20
