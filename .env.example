# Local infrastructure. Replace these development-only values outside local use.
POSTGRES_DB=cognigraph
POSTGRES_USER=cognigraph
POSTGRES_PASSWORD=cognigraph-local-password
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=cognigraph-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

API_PORT=8000
FRONTEND_PORT=8080
# Frontend build base images. Override these only when a mirror or local cache is required.
FRONTEND_NODE_IMAGE=node:22-alpine
FRONTEND_NGINX_IMAGE=nginx:1.27-alpine

COGNIGRAPH_ENVIRONMENT=development
COGNIGRAPH_WORKSPACE_SCOPE_REQUIRED=false
# Required by POST /v1/workspaces when COGNIGRAPH_ENVIRONMENT=production.
COGNIGRAPH_WORKSPACE_PROVISIONING_TOKEN=
COGNIGRAPH_DATABASE_URL=postgresql+asyncpg://cognigraph:cognigraph-local-password@localhost:5432/cognigraph
COGNIGRAPH_NEO4J_URI=bolt://localhost:7687
COGNIGRAPH_NEO4J_USER=neo4j
COGNIGRAPH_NEO4J_PASSWORD=cognigraph-local-password
COGNIGRAPH_NEO4J_REQUIRED=false
COGNIGRAPH_STORAGE_PATH=data/uploads
COGNIGRAPH_MAX_UPLOAD_BYTES=26214400

# Mock mode is deterministic and needs no provider credentials.
COGNIGRAPH_USE_MOCK_LLM=true
COGNIGRAPH_MOCK_LEARNING_INSIGHTS_FIXTURE_ENABLED=false
COGNIGRAPH_TEACHER_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_EXTRACTOR_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_GRADER_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_GRAPH_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_GRAPH_MODEL_ENABLED=true
COGNIGRAPH_VISION_MODEL=openai/gpt-4.1-mini
COGNIGRAPH_EMBEDDING_MODEL=openai/text-embedding-3-small
COGNIGRAPH_FALLBACK_MODELS=[]
COGNIGRAPH_API_KEY=
# Compose also forwards these common LiteLLM provider variables. Configure
# only the providers used by the selected role models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=
COGNIGRAPH_LLM_TIMEOUT_SECONDS=30
COGNIGRAPH_LLM_MAX_RETRIES=2
COGNIGRAPH_LLM_MAX_CONCURRENCY=4
COGNIGRAPH_TOOL_CALLING_ENABLED=true
COGNIGRAPH_MAX_TOOL_STEPS=4
COGNIGRAPH_MAX_TOOL_RESULT_BYTES=30000
COGNIGRAPH_TOOL_TIMEOUT_SECONDS=10

# Visual ingestion. Install with ``uv sync --extra ocr`` for PaddleOCR and
# scanned-PDF rendering. Vision remains a final fallback for low-quality OCR.
COGNIGRAPH_OCR_ENABLED=false
COGNIGRAPH_VISION_ENABLED=true
COGNIGRAPH_VISION_FALLBACK_ENABLED=true
COGNIGRAPH_OCR_LOW_CONFIDENCE_THRESHOLD=0.6
COGNIGRAPH_OCR_MIN_TEXT_QUALITY=0.2
COGNIGRAPH_VISION_MAX_IMAGE_BYTES=12582912
COGNIGRAPH_VISION_MAX_OUTPUT_BLOCKS=500
COGNIGRAPH_OCR_PDF_DPI=200

COGNIGRAPH_MAX_CONTEXT_TOKENS=4000
COGNIGRAPH_MAX_RECENT_TURNS=6
COGNIGRAPH_MAX_GRAPH_DEPTH=3
COGNIGRAPH_MAX_GRAPH_NODES=100
# Legacy aliases accepted during migration:
# COGNIGRAPH_CONTEXT_TOKEN_BUDGET, COGNIGRAPH_RECENT_TURN_LIMIT,
# COGNIGRAPH_GRAPH_MAX_DEPTH, COGNIGRAPH_GRAPH_MAX_NODES
COGNIGRAPH_OUTBOX_WORKER_ENABLED=true
COGNIGRAPH_OUTBOX_POLL_INTERVAL_SECONDS=1
COGNIGRAPH_OUTBOX_BATCH_SIZE=20
# Optional exact browser Origins for cross-origin API access. Leave empty when
# the Vite or Nginx same-origin proxy is used. Wildcards are rejected.
# Example: COGNIGRAPH_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COGNIGRAPH_CORS_ALLOWED_ORIGINS=
